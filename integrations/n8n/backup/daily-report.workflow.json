{
  "name": "Skyline Echo — Daily report recovery template",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50 23 * * *"
            }
          ]
        }
      },
      "id": "backup-node-1",
      "name": "Daily at 23:50 Eastern",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {},
      "id": "backup-node-2",
      "name": "Send setup test manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        624
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{report_test:true}}];"
      },
      "id": "backup-node-3",
      "name": "Set test mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        624
      ]
    },
    {
      "parameters": {
        "command": "=  SKYLINE_REPORT_TEST={{ $json.report_test ? '1' : '0' }} /opt/skyline-echo/.venv/bin/python -c 'import base64;exec(base64.b64decode(\"\"))'"
      },
      "id": "backup-node-4",
      "name": "Build daily ledger report",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        512,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=JSON.parse($input.first().json.stdout); if(r.skip) return []; return [{json:r}];"
      },
      "id": "backup-node-5",
      "name": "Parse report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "backup-node-6",
      "name": "Send through Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1008,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const id=$input.first().json.id; const key=$('Parse report').first().json.report_key; if(typeof id!=='string'||!/^[a-f0-9-]{36}$/i.test(id)) throw new Error('Resend did not return a valid email ID'); if(!/^[a-z0-9-]+$/.test(key)) throw new Error('Invalid report key'); return [{json:{email_id:id,report_key:key}}];"
      },
      "id": "backup-node-7",
      "name": "Validate email acceptance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        400
      ]
    },
    {
      "parameters": {
        "command": "={{ \"/opt/skyline-echo/.venv/bin/python -c 'import json,sys,datetime;from pathlib import Path;p=Path('\\\"'\\\"'/var/lib/skyline-echo/email-reports'\\\"'\\\"')/(sys.argv[1]+'\\\"'\\\"'.sent.json'\\\"'\\\"');t=p.with_suffix('\\\"'\\\"'.tmp'\\\"'\\\"');t.write_text(json.dumps({'\\\"'\\\"'email_id'\\\"'\\\"':sys.argv[2],'\\\"'\\\"'accepted_at'\\\"'\\\"':datetime.datetime.now(datetime.timezone.utc).isoformat()}));t.replace(p);print(json.dumps({'\\\"'\\\"'status'\\\"'\\\"':'\\\"'\\\"'accepted_by_resend'\\\"'\\\"','\\\"'\\\"'email_id'\\\"'\\\"':sys.argv[2]}))' \" + $json.report_key + \" \" + $json.email_id }}"
      },
      "id": "backup-node-8",
      "name": "Record successful send",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1504,
        400
      ]
    },
    {
      "parameters": {
        "content": "## Daily report recovery template\n\nPublic sanitized snapshot, 2026-10-29. Inactive on import.\n\nBefore executing: configure your sender/recipients and application/n8n URLs in the embedded report Python; reconnect Resend Header Auth. See README.md in integrations/n8n/backup.\n\nSchedule: 23:50 America/New_York. Keep server ledgers and email sent markers in a separate private backup. This test is one-time and may skip once marked sent.",
        "height": 350,
        "width": 1000
      },
      "id": "backup-node-9",
      "name": "Setup and safeguards",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    }
  ],
  "connections": {
    "Daily at 23:50 Eastern": {
      "main": [
        [
          {
            "node": "Build daily ledger report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send setup test manually": {
      "main": [
        [
          {
            "node": "Set test mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set test mode": {
      "main": [
        [
          {
            "node": "Build daily ledger report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build daily ledger report": {
      "main": [
        [
          {
            "node": "Parse report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse report": {
      "main": [
        [
          {
            "node": "Send through Resend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send through Resend": {
      "main": [
        [
          {
            "node": "Validate email acceptance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate email acceptance": {
      "main": [
        [
          {
            "node": "Record successful send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "timeSavedMode": "fixed",
    "callerPolicy": "workflowsFromSameOwner",
    "timezone": "America/New_York"
  },
  "active": false,
  "pinData": {}
}
