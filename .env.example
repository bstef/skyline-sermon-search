# Export these in your shell; this file is documentation, not loaded automatically.
# Transcription only. No transcription starts just by configuring a key.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Optional override; defaults to transcripts/ alongside SERMON_DB.
# TRANSCRIPT_CACHE_DIR=data/transcripts
# Embeddings and meaning-based search only.
OPENAI_API_KEY=
SERMON_DB=data/sermons.sqlite3
